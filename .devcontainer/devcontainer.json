{
    "name": "Pico Router Dev",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "postStartCommand": "mkdir -p third_party/Renode_RP2040/piosim third_party/Renode_RP2040/emulation/bin && ln -sf /opt/piosim/libpiosim.so third_party/Renode_RP2040/piosim/libpiosim.so && ln -sfn /opt/renode-rp2040/emulation third_party/Renode_RP2040/emulation/bin/Release",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-vscode.cmake-tools"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "C_Cpp.formatting": "clangFormat"
            }
        }
    }
}