{
    "name": "Pico Router Dev",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "postCreateCommand": "mkdir -p third_party/Renode_RP2040/piosim && ln -sf /opt/piosim/libpiosim.so third_party/Renode_RP2040/piosim/libpiosim.so",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-vscode.cmake-tools"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "C_Cpp.formatting": "clangFormat"
            }
        }
    }
}